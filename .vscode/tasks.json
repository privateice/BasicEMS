{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build BasicEMS",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "main.cpp",
                "Employee.cpp",
                "Permissions.cpp",
                "EmployeesList.cpp",
                "Login.cpp",
                "-o",
                "${workspaceFolder}/BasicEMS"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the complete BasicEMS project with clang++"
        }
    ]
}